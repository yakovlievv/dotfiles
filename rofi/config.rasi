configuration {
    modes:                 "drun,menu:rofi-modes,calc";
    combi-modes:           "menu:rofi-modes,drun,calc";
    show-icons:            true;
    icon-theme:            "Papirus-Dark";
    drun-display-format:   "{name}";
    combi-display-format:  "{text}";
    combi-hide-mode-prefix: true;
    font:                  "JetBrainsMono Nerd Font 13";
    terminal:              "kitty";

    /* C-j/C-k for navigation; default bindings of C-j/C-k must be freed first */
    kb-accept-entry:       "Return,KP_Enter";
    kb-remove-to-eol:      "";
    kb-row-down:           "Down,Control+j";
    kb-row-up:             "Up,Control+k";
}

@theme "kanagawa"
