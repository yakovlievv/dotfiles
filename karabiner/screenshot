#!/bin/sh
# screenshot [region|screen]: save to ~/Pictures/Screenshots and copy to the clipboard,
# like the SUPER+S bind on arch. Called from super.conf.
# Needs Screen Recording for Karabiner-Console-User-Server.
dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

case "$1" in
    screen) /usr/sbin/screencapture -m "$file" ;;
    *) /usr/sbin/screencapture -i "$file" ;;
esac

[ -f "$file" ] || exit 0 # cancelled with Esc
/usr/bin/osascript -e "set the clipboard to (read (POSIX file \"$file\") as «class PNGf»)"
